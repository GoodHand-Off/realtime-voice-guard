# Required ------------------------------------------------------------------
# An OpenAI API key with Realtime access. Only the guard ever sees it.
OPENAI_API_KEY=
# Signs call tickets. 32+ random characters; `npm run setup` fills it in.
GUARD_SIGNING_SECRET=
# Your backend sends this to POST /v1/tickets and the admin routes. 32+ characters, different from the above; `npm run setup` fills it in.
GUARD_API_KEY=

# Caps (defaults shown) -----------------------------------------------------
# Hard ceilings. A ticket may ask for less, never more.
MAX_CALL_SECONDS=600
# Also the cap a ticket gets when it asks for none. It must cover two worst-case
# responses on every priced model (npm run cost-model shows the minimum).
MAX_CALL_COST_USD=1.00
MAX_CONCURRENT_CALLS=100
# Forced onto every session and every relayed response.create (OpenAI allows 1 to 4096).
MAX_OUTPUT_TOKENS=1024
# Conversation tokens each response may re-read after the instructions (OpenAI's truncation limit).
# Raising it raises every response's worst case, and so the smallest cap a call can run under.
MAX_INPUT_TOKENS=4000
MAX_RESPONSES_PER_CALL=300

# Server --------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
# Browser origins allowed to POST SDP offers, comma separated. Empty = none.
ALLOWED_ORIGINS=http://localhost:3000
# Call attempts per client address per minute on the public routes (0 = off).
RATE_LIMIT_PER_MINUTE=60
# Proxies you run in front of the guard (1 behind a single load balancer). 0 ignores X-Forwarded-For.
TRUSTED_PROXIES=0
# How long shutdown waits for hang-ups. Give the process longer than this to stop.
SHUTDOWN_GRACE_SECONDS=25
# Price table. Empty = the prices.json shipped with the guard (a dated snapshot of OpenAI's pricing page).
PRICES_FILE=
HEARTBEAT_SECONDS=15
TICKET_TTL_SECONDS=120

# Optional: durable ledger shared by several instances ----------------------
REDIS_URL=
REDIS_PREFIX=rvg:

# Optional: POST each settled call to your backend --------------------------
SETTLE_WEBHOOK_URL=
SETTLE_WEBHOOK_SECRET=

# Testing only: point the guard at a mock OpenAI.
OPENAI_BASE_URL=
