{
  "name": "realtime-voice-guard",
  "version": "0.1.0",
  "description": "A small service between your app and the OpenAI Realtime voice API that caps each call's duration and estimated spend and hangs up server-side.",
  "keywords": [
    "openai",
    "openai-realtime",
    "realtime-api",
    "voice-ai",
    "webrtc",
    "websocket",
    "cost-control",
    "rate-limiting",
    "proxy",
    "typescript"
  ],
  "homepage": "https://github.com/GoodHand-Off/realtime-voice-guard#readme",
  "bugs": {
    "url": "https://github.com/GoodHand-Off/realtime-voice-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoodHand-Off/realtime-voice-guard.git"
  },
  "license": "Apache-2.0",
  "author": "GoodHandoff (https://goodhandoff.com)",
  "type": "module",
  "sideEffects": [
    "./dist/main.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "realtime-voice-guard": "./dist/main.js"
  },
  "files": [
    "dist",
    "prices.json",
    "NOTICE",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "setup": "node scripts/setup.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cost-model": "npm run build --silent && node scripts/cost-model.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:licenses && npm audit --omit=dev --audit-level=high",
    "prepack": "npm run clean && npm run build",
    "test:coverage": "vitest run --coverage",
    "test:pack": "node scripts/smoke-pack.mjs"
  },
  "dependencies": {
    "redis": "^5.12.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
